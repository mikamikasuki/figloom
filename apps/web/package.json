{
  "name": "figloom-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "api:types": "openapi-typescript ../../docs/openapi.json -o src/generated/api-schema.ts --default-non-nullable false",
    "api:check": "openapi-typescript ../../docs/openapi.json -o src/generated/api-schema.ts --default-non-nullable false --check",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^29.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
